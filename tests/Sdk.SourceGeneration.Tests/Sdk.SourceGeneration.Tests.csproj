<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks></TargetFrameworks>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <RootNamespace>Sdk.SourceGeneration.Tests</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FakeItEasy" Version="9.0.1" />
        <!-- AB#8423: validates the generated method documents against the recorded asset-repo schema (same GraphQL.NET as the asset repository). -->
        <PackageReference Include="GraphQL" Version="8.8.5" />
        <!-- Same Roslyn as the generator (pinned to the .NET SDK's compiler); used to compile generated code. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <!-- The generator references the CK engine with PrivateAssets=all; the tests build CK DTOs themselves. -->
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.Engine" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Communication.Contracts\Communication.Contracts.csproj" />
        <!-- AB#8423: the generated method clients derive from CkMethodClientBase. -->
        <ProjectReference Include="..\..\src\Sdk.ServiceClient\Sdk.ServiceClient.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The code generators are compiled into the test assembly instead of referencing the
             netstandard2.0 analyzer project: its copy-local netstandard facades conflict with the
             net10.0 runtime assemblies (MSB3243). The Roslyn entry point (CkDtoSourceGenerator) is
             not needed - the tests drive the generators directly. -->
        <Compile Include="..\..\src\Sdk.SourceGeneration\AttributeCodeGenerator.cs" Link="Generator\AttributeCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\QueryDtoCodeGenerator.cs" Link="Generator\QueryDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\MutationDtoCodeGenerator.cs" Link="Generator\MutationDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\IQueryDtoCodeGenerator.cs" Link="Generator\IQueryDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\IMutationDtoCodeGenerator.cs" Link="Generator\IMutationDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\Utilities.cs" Link="Generator\Utilities.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\CkDtoModelBinder.cs" Link="Generator\CkDtoModelBinder.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\CkEnumCodeGenerator.cs" Link="Generator\CkEnumCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\CkModelSourceEmitter.cs" Link="Generator\CkModelSourceEmitter.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\MethodClientCodeGenerator.cs" Link="Generator\MethodClientCodeGenerator.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- AB#6715: real octo-ckc output (range retention) of a one-type model on System-2.5.0. -->
        <None Include="Fixtures\*" CopyToOutputDirectory="PreserveNewest" />
        <!-- AB#8423: generator output recorded before the method clients existed (byte-identity gate). -->
        <None Include="Fixtures\Golden\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures\Golden" />
    </ItemGroup>

</Project>
