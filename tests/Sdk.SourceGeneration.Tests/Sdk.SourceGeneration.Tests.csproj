<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks></TargetFrameworks>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <RootNamespace>Sdk.SourceGeneration.Tests</RootNamespace>
        <Configurations>Debug;Release;DebugL</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FakeItEasy" Version="9.0.1" />
        <!-- Same Roslyn as the generator (pinned to the .NET SDK's compiler); used to compile generated code. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <!-- The generator references the CK engine with PrivateAssets=all; the tests build CK DTOs themselves. -->
        <PackageReference Include="Meshmakers.Octo.ConstructionKit.Engine" Version="$(OctoCoreLibVersion)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Communication.Contracts\Communication.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The code generators are compiled into the test assembly instead of referencing the
             netstandard2.0 analyzer project: its copy-local netstandard facades conflict with the
             net10.0 runtime assemblies (MSB3243). The Roslyn entry point (CkDtoSourceGenerator) is
             not needed - the tests drive the generators directly. -->
        <Compile Include="..\..\src\Sdk.SourceGeneration\AttributeCodeGenerator.cs" Link="Generator\AttributeCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\QueryDtoCodeGenerator.cs" Link="Generator\QueryDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\MutationDtoCodeGenerator.cs" Link="Generator\MutationDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\IQueryDtoCodeGenerator.cs" Link="Generator\IQueryDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\IMutationDtoCodeGenerator.cs" Link="Generator\IMutationDtoCodeGenerator.cs" />
        <Compile Include="..\..\src\Sdk.SourceGeneration\Utilities.cs" Link="Generator\Utilities.cs" />
    </ItemGroup>

</Project>
